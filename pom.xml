<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sitelock</groupId>
  <artifactId>sitelock-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>SiteLock (parent)</name>
  <description>SiteLock: local blocking via /etc/hosts + DNS server for the local network.</description>

  <modules>
    <module>sitelock-core</module>
    <module>sitelock-dns</module>
    <module>sitelock-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Fixed build timestamp: without it the jar carries the machine time and two
         builds of the same revision come out with different bytes. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Java 26: the project's official target (language and bytecode). -->
    <maven.compiler.release>26</maven.compiler.release>
    <picocli.version>4.7.6</picocli.version>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sitelock</groupId>
        <artifactId>sitelock-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sitelock</groupId>
        <artifactId>sitelock-dns</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <!-- WHY: without <configuration> here, the target comes from
               ${maven.compiler.release}. With <release> pinned in the plugin,
               the property was ignored, so changing it did nothing. -->
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <!-- Pinned versions: without them, each machine uses whatever plugin
             came with its installed Maven, and the same code produces different jars. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <!-- WHY: without this, in a build without 'clean' the jar plugin does
                 not recreate the jar (it is newer than the classes) and shade
                 shadows the previous fat-jar: the 'original-' is no longer the thin jar. -->
            <forceCreation>true</forceCreation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- A missing JDK or Maven becomes a clear message instead of
           "release version 26 not supported" in the middle of compilation. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>requires-java-26-and-maven-3.8</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[26,)</version>
                  <message>This project requires Java 26 or newer (CI uses Temurin 26).</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                  <message>This project requires Maven 3.8 or newer. Use the ./mvnw that ships with the repository.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage report. No gate: a threshold would break the build for
           reasons unrelated to whoever is changing the code. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <!-- prepare-package: runs after 'test' (suite) and before
                 'package', so the report also exists in a package-only build. -->
            <id>report</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
