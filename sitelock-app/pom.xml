<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sitelock</groupId>
    <artifactId>sitelock-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>sitelock-app</artifactId>
  <name>SiteLock App (CLI)</name>
  <description>CLI siteblock: block/unblock/status/reset + dns start/stop/status.</description>

  <dependencies>
    <dependency>
      <groupId>com.sitelock</groupId>
      <artifactId>sitelock-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sitelock</groupId>
      <artifactId>sitelock-dns</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <!-- POR QUE: nem jackson-databind nem jackson-datatype-jsr310 sao declarados
         aqui. Nenhum arquivo deste modulo importa Jackson (grep confirma) e as
         duas chegam transitivas pelo sitelock-core, que e quem as usa. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>siteblock-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>${picocli.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- POR QUE: shade em vez de assembly, que só colocaria os arquivos das
           dependências lado a lado: o shade desempacota e reempacota num único
           JAR, com merge de recursos e ManifestResourceTransformer (Main-Class). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- POR QUE: sem isto, o META-INF/services de um módulo Jackson
                     sobrescreve o do outro e o módulo some em silêncio. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sitelock.SiteLockApplication</mainClass>
                </transformer>
              </transformers>
              <filters>
                <!-- ATENÇÃO: assinatura de dependência no fat-jar deixa o jar
                     ilegível (o JVM recusa a assinatura). -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
