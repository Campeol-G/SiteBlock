<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sitelock</groupId>
    <artifactId>sitelock-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>sitelock-app</artifactId>
  <name>SiteLock App (CLI)</name>
  <description>siteblock CLI: block/unblock/status/reset + dns start/stop/status.</description>

  <dependencies>
    <dependency>
      <groupId>com.sitelock</groupId>
      <artifactId>sitelock-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sitelock</groupId>
      <artifactId>sitelock-dns</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <!-- WHY: neither jackson-databind nor jackson-datatype-jsr310 is declared
         here. No file in this module imports Jackson (grep confirms), and both
         arrive transitively through sitelock-core, which is what uses them. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>siteblock-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>${picocli.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- WHY: shade instead of assembly, which would only place the dependency
           files side by side: shade unpacks and repacks them into a single
           JAR, merging resources and using ManifestResourceTransformer (Main-Class). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- WHY: without this, the META-INF/services file of one Jackson
                     module overwrites the other's and the module silently disappears. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sitelock.SiteLockApplication</mainClass>
                </transformer>
              </transformers>
              <filters>
                <!-- WARNING: dependency signatures in the fat JAR leave the JAR
                     unreadable (the JVM rejects the signature). -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
